# Casa Escencia: sitio estático exportado desde Next.js (out/ → public_html).
# Las redirecciones 301 conservan el SEO de las URLs del WordPress anterior.

RedirectMatch 302 ^/$ /es/
ErrorDocument 404 /404.html

# Tienda y carrito anteriores → mayoreo (prefijo: captura también /store/<producto>).
Redirect 301 /cart /es/wholesale/
Redirect 301 /store /es/wholesale/
Redirect 301 /producto/aura-hair-brush /es/wholesale/aura-hair-brush/
Redirect 301 /producto/ease-hair-comb /es/wholesale/ease-hair-comb/

# Artículos que vivían en la raíz → /blog/<slug>.
Redirect 301 /aura-hair-brush-el-inicio-de-un-ritual /es/blog/aura-hair-brush-el-inicio-de-un-ritual/
Redirect 301 /how-choosing-the-right-brush-can-change-your-hairs-health /es/blog/how-choosing-the-right-brush-can-change-your-hairs-health/
Redirect 301 /mindful-brushing-a-micro-ritual /es/blog/mindful-brushing-a-micro-ritual/
Redirect 301 /the-art-of-turning-daily-care-into-a-beauty-ritual /es/blog/the-art-of-turning-daily-care-into-a-beauty-ritual/

# El service worker nunca se cachea: así cada despliegue lo actualiza.
<Files "sw.js">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Service-Worker-Allowed "/"
</Files>
