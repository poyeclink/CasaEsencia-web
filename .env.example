# URL pública del sitio (sin slash final) — se usa en sitemap, canonical y datos estructurados.
NEXT_PUBLIC_SITE_URL="https://casaescencia.com"

# Conexión pooled (Supavisor/PgBouncer) — la usa la app en runtime (src/lib/prisma.ts), serverless-friendly.
# Formato Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=""

# Conexión directa — la usa el CLI de Prisma (migrate/db push/studio) vía prisma7.config.ts.
# Usar el Session pooler (puerto 5432, mismo host que el pooler de arriba) en vez de db.[project-ref].supabase.co:
# ese host de conexión directa real solo resuelve por IPv6 y muchas redes no tienen salida IPv6 (ETIMEDOUT).
# Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=""

# Secreto para firmar las cookies de sesión (JWT). Generar uno distinto por entorno,
# por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
SESSION_COOKIE_NAME="app_session"

# Cuenta de administrador inicial — la crea/actualiza `pnpm db:seed` (upsert, idempotente).
# Sin auto-registro de admins por diseño: se crean solo por este seed.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Cloudflare R2 (almacenamiento de archivos/imágenes). Ver panel de Cloudflare > R2.
# Dejar vacío hasta que el proyecto concreto lo necesite (ej. imágenes de producto).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Dominio público desde el que se sirven los objetos del bucket (custom domain o el *.r2.dev), sin slash final.
R2_PUBLIC_URL=""

# Cliente de prueba opcional — `pnpm db:seed` lo crea/actualiza solo si ambos están definidos.
# Solo para desarrollo: no configurar en producción.
DEMO_CUSTOMER_EMAIL=""
DEMO_CUSTOMER_PASSWORD=""
